    function closeCart(){ $('cartDrawer').classList.remove('open'); $('drawerBackdrop').classList.remove('open'); $('cartDrawer').setAttribute('aria-hidden','true'); updateBodyLock(); }
    function openProduct(id){ const p=products.find(item=>item.id===Number(id)); if(!p)return; activeProduct=p; selectedSize='M'; selectedColor=p.color; activeImageIndex=0; renderProductDetail(); openLayer('productModal'); }
    function renderProductDetail(){ const p=activeProduct; $('productDetail').innerHTML=`<div class="grid md:grid-cols-2"><div class="p-4 sm:p-6"><button class="main-product-image block w-full cursor-zoom-in overflow-hidden" aria-label="Enlarge product image"><img class="w-full aspect-[.82] object-cover transition-transform duration-500 hover:scale-105" src="${escapeHtml(p.images[activeImageIndex])}" alt="${escapeHtml(p.name)}"></button><div class="flex gap-2 mt-3 overflow-x-auto">${p.images.map((img,i)=>`<button class="thumb ${i===activeImageIndex?'selected':''} shrink-0" data-image-index="${i}"><img class="w-14 h-16 sm:w-16 sm:h-20 object-cover" src="${escapeHtml(img)}" alt="${escapeHtml(p.name)} view ${i+1}"></button>`).join('')}</div></div><div class="p-5 sm:p-8 md:pt-12"><p class="eyebrow gold">${escapeHtml(p.category)} · ${escapeHtml(p.occasion)}</p><h2 class="serif text-3xl sm:text-4xl leading-tight mt-3">${escapeHtml(p.name)}</h2><p class="mt-3 text-lg">${money(p.price)}</p><p class="text-xs mt-2 text-[#a7834f]">★★★★★ <span class="text-[var(--muted)]">${p.reviews.length} considered reviews</span></p><p class="text-sm text-[var(--muted)] leading-6 mt-5">${escapeHtml(p.desc)}</p><div class="mt-6"><div class="flex justify-between items-center mb-3"><span class="eyebrow text-[9px]">Select size</span><button id="sizeGuideBtn" class="text-[10px] underline text-[var(--muted)]">Size guide</button></div><div class="flex gap-2">${p.sizes.map(s=>`<button class="size-option border border-[var(--line)] w-11 h-10 text-xs ${s===selectedSize?'selected':''}" data-size="${s}">${s}</button>`).join('')}</div></div><div class="mt-6"><p class="eyebrow text-[9px] mb-3">Colour · <span id="selectedColorLabel" class="normal-case tracking-normal">${escapeHtml(selectedColor)}</span></p><div class="flex gap-3">${p.colors.map(c=>`<button class="swatch ${c[0]===selectedColor?'selected':''}" style="background:${c[1]}" data-color="${escapeHtml(c[0])}" aria-label="${escapeHtml(c[0])}" title="${escapeHtml(c[0])}"></button>`).join('')}</div></div><div class="grid grid-cols-2 gap-2 mt-7"><button id="addProductBtn" class="solid-btn bg-[#292823] text-white py-3 text-[10px] tracking-[.14em] uppercase">Add to bag</button><button id="buyNowBtn" class="border border-[#292823] py-3 text-[10px] tracking-[.14em] uppercase hover:bg-[#292823] hover:text-white">Buy now</button></div><div class="border-t border-[var(--line)] mt-7 pt-5 space-y-3"><details><summary class="text-xs cursor-pointer">Fabric & craftsmanship</summary><p class="text-xs text-[var(--muted)] leading-5 mt-2">${escapeHtml(p.fabricInfo)}</p></details><details><summary class="text-xs cursor-pointer">Care instructions</summary><p class="text-xs text-[var(--muted)] leading-5 mt-2">${escapeHtml(p.care)}</p></details><details><summary class="text-xs cursor-pointer">Complimentary delivery</summary><p class="text-xs text-[var(--muted)] leading-5 mt-2">Complimentary shipping on orders over ₹5,000. Thoughtfully packed and delivered across India.</p></details></div><div class="border-t border-[var(--line)] mt-6 pt-5"><h3 class="serif text-xl mb-4">Notes from our customers</h3><div class="space-y-4">${p.reviews.map((r,i)=>`<div class="border-b border-[var(--line)] pb-3"><div class="flex items-center justify-between"><span class="text-xs font-semibold">${escapeHtml(r[0])} <span class="ml-1 text-[9px] text-[#66805d]">✓ VERIFIED</span></span><span class="text-[#a7834f] text-xs">${r[1]}</span></div><p class="text-xs text-[var(--muted)] leading-5 mt-2">${escapeHtml(r[2])}</p><img class="w-14 h-16 object-cover mt-2" src="${escapeHtml(p.images[(i+1)%p.images.length])}" alt="Customer photo for ${escapeHtml(p.name)} review" loading="lazy"></div>`).join('')}</div></div></div></div>`; }
    function openLightbox(){ $('lightboxImage').src=activeProduct.images[activeImageIndex]; openLayer('lightbox'); }
    function moveLightbox(direction){ activeImageIndex=(activeImageIndex+direction+activeProduct.images.length)%activeProduct.images.length; $('lightboxImage').src=activeProduct.images[activeImageIndex]; const main=$('productDetail').querySelector('.main-product-image img'); if(main)main.src=activeProduct.images[activeImageIndex]; document.querySelectorAll('.thumb').forEach((t,i)=>t.classList.toggle('selected',i===activeImageIndex)); }
    function openSearchResults(value,suggestionEl){ const q=value.trim().toLowerCase(); if(!q){suggestionEl.classList.add('hidden');renderProducts();return;} const matches=products.filter(p=>`${p.name} ${p.category} ${p.color} ${p.fabric} ${p.occasion}`.toLowerCase().includes(q)).slice(0,5); suggestionEl.innerHTML=matches.length?matches.map(p=>`<button class="suggestion w-full text-left flex items-center gap-3 p-3 border-b border-[var(--line)] hover:bg-stone-50" data-suggest="${p.id}"><img class="w-10 h-12 object-cover" src="${escapeHtml(p.image)}" alt=""><span class="flex-1"><span class="block text-xs">${escapeHtml(p.name)}</span><span class="text-[10px] text-[var(--muted)]">${money(p.price)}</span></span></button>`).join(''):'<p class="p-4 text-xs text-[var(--muted)]">No pieces found. Try another search.</p>'; suggestionEl.classList.remove('hidden'); renderProducts(); }
    function checkoutRender(){ const content=$('checkoutContent'); const subtotal=cart.reduce((n,i)=>n+i.price*i.qty,0); const steps=['Shipping','Payment','Review']; const progress=`<div class="flex gap-2 mb-7">${steps.map((s,i)=>`<div class="flex-1 border-t-2 ${i+1<=checkoutStep?'border-[#a7834f]':'border-[var(--line)]'} pt-2 text-[9px] uppercase tracking-widest ${i+1===checkoutStep?'text-[var(--ink)]':'text-[var(--muted)]'}">0${i+1} · ${s}</div>`).join('')}</div>`; let body='';
      if(checkoutStep===1) body=`<h3 class="serif text-2xl mb-5">Where should we send it?</h3><form id="shippingForm" class="grid sm:grid-cols-2 gap-3"><label class="text-[10px]">First name<input required name="firstName" autocomplete="given-name" class="block w-full mt-1 border border-[var(--line)] bg-transparent px-3 py-2.5 text-xs"></label><label class="text-[10px]">Last name<input required name="lastName" autocomplete="family-name" class="block w-full mt-1 border border-[var(--line)] bg-transparent px-3 py-2.5 text-xs"></label><label class="text-[10px] sm:col-span-2">Email address<input required type="email" name="email" autocomplete="email" class="block w-full mt-1 border border-[var(--line)] bg-transparent px-3 py-2.5 text-xs"></label><label class="text-[10px] sm:col-span-2">Address<input required name="address" autocomplete="street-address" class="block w-full mt-1 border border-[var(--line)] bg-transparent px-3 py-2.5 text-xs"></label><label class="text-[10px]">City<input required name="city" autocomplete="address-level2" class="block w-full mt-1 border border-[var(--line)] bg-transparent px-3 py-2.5 text-xs"></label><label class="text-[10px]">PIN code<input required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" name="pin" autocomplete="postal-code" class="block w-full mt-1 border border-[var(--line)] bg-transparent px-3 py-2.5 text-xs"></label><label class="text-[10px] sm:col-span-2">Phone number<input required type="tel" name="phone" autocomplete="tel" pattern="[0-9+() -]{8,}" class="block w-full mt-1 border border-[var(--line)] bg-transparent px-3 py-2.5 text-xs"></label><button class="solid-btn sm:col-span-2 bg-[#292823] text-white py-3 mt-2 text-[10px] tracking-widest uppercase">Continue to payment</button></form>`;
      if(checkoutStep===2) body=`<h3 class="serif text-2xl mb-5">Choose a payment method</h3><form id="paymentForm" class="space-y-3"><label class="flex items-center gap-3 border border-[var(--line)] p-4 text-xs"><input type="radio" name="payment" value="UPI" required checked> UPI · Google Pay, PhonePe, Paytm</label><label class="flex items-center gap-3 border border-[var(--line)] p-4 text-xs"><input type="radio" name="payment" value="Card"> Credit or debit card</label><label class="flex items-center gap-3 border border-[var(--line)] p-4 text-xs"><input type="radio" name="payment" value="Cash on delivery"> Cash on delivery</label><div class="flex gap-3 pt-3"><button type="button" id="checkoutBack" class="flex-1 border border-[var(--line)] py-3 text-[10px] uppercase tracking-widest">Back</button><button class="solid-btn flex-1 bg-[#292823] text-white py-3 text-[10px] tracking-widest uppercase">Review order</button></div></form>`;
      if(checkoutStep===3) body=`<h3 class="serif text-2xl mb-4">A final look</h3><div class="text-xs text-[var(--muted)] mb-4">${cart.map(i=>`<div class="flex justify-between py-2 border-b border-[var(--line)]"><span>${i.qty} × ${escapeHtml(i.name)} <span class="text-[10px]">(${escapeHtml(i.size)}, ${escapeHtml(i.color)})</span></span><span>${money(i.price*i.qty)}</span></div>`).join('')}</div><div class="flex justify-between text-sm py-3"><span>Subtotal</span><span>${money(subtotal)}</span></div><div class="flex justify-between text-sm border-b border-[var(--line)] pb-4"><span>Shipping</span><span>${subtotal>=15000?'Complimentary':'₹450'}</span></div><div class="flex justify-between serif text-xl py-4"><span>Total</span><span>${money(subtotal+(subtotal>=15000?0:450))}</span></div><p class="text-[10px] text-[var(--muted)] mb-4">This is a storefront demo. No payment will be collected and no order will be sent.</p><div class="flex gap-3"><button id="checkoutBack" class="flex-1 border border-[var(--line)] py-3 text-[10px] uppercase tracking-widest">Back</button><button id="placeOrder" class="solid-btn flex-1 bg-[#292823] text-white py-3 text-[10px] tracking-widest uppercase">Place demo order</button></div>`;
      content.innerHTML=`<p class="eyebrow gold mb-2">Secure checkout</p><h2 class="serif text-3xl mb-6">Complete your order</h2>${progress}<div class="grid md:grid-cols-[1fr_210px] gap-7"><div>${body}</div><aside class="bg-stone-50 dark:bg-stone-800 p-4 h-fit"><p class="eyebrow text-[9px] mb-3">Order summary</p><p class="text-xs">${cart.reduce((n,i)=>n+i.qty,0)} item(s)</p><p class="serif text-xl mt-2">${money(subtotal)}</p></aside></div>`;
      const sf=$('shippingForm'); if(sf)sf.addEventListener('submit',e=>{e.preventDefault();if(sf.reportValidity()){checkoutStep=2;checkoutRender();}});
      const pf=$('paymentForm'); if(pf)pf.addEventListener('submit',e=>{e.preventDefault();if(pf.reportValidity()){checkoutStep=3;checkoutRender();}});
      const back=$('checkoutBack'); if(back)back.addEventListener('click',()=>{checkoutStep--;checkoutRender();});
      const place=$('placeOrder'); if(place)place.addEventListener('click',()=>{cart=[];saveCart();updateCart();closeLayer('checkoutModal');closeCart();showToast('Thank you — your demo order is complete.');checkoutStep=1;});
    }

    $('productGrid').addEventListener('click',e=>{ const quick=e.target.closest('[data-quick]'); if(quick){e.stopPropagation();const p=products.find(i=>i.id===Number(quick.dataset.quick));addToCart(p,'M',p.color);return;} const card=e.target.closest('[data-product]');if(card)openProduct(card.dataset.product); });
    $('arrivalRow').addEventListener('click',e=>{ const quick=e.target.closest('[data-quick]');if(quick){e.stopPropagation();const p=products.find(i=>i.id===Number(quick.dataset.quick));addToCart(p,'M',p.color);return;}const card=e.target.closest('[data-product]');if(card)openProduct(card.dataset.product); });
    document.addEventListener('click',e=>{const close=e.target.closest('[data-close]');if(close)closeLayer(close.dataset.close);const suggestion=e.target.closest('[data-suggest]');if(suggestion){openProduct(suggestion.dataset.suggest);$('searchSuggestions').classList.add('hidden');$('mobileSearchSuggestions').classList.add('hidden');}});
    $('productDetail').addEventListener('click',e=>{const size=e.target.closest('[data-size]');if(size){selectedSize=size.dataset.size;renderProductDetail();return;}const color=e.target.closest('[data-color]');if(color){selectedColor=color.dataset.color;renderProductDetail();return;}const thumb=e.target.closest('[data-image-index]');if(thumb){activeImageIndex=Number(thumb.dataset.imageIndex);renderProductDetail();return;}if(e.target.closest('#sizeGuideBtn')){openLayer('sizeGuideModal');return;}if(e.target.closest('.main-product-image')){openLightbox();return;}if(e.target.closest('#addProductBtn')){addToCart(activeProduct,selectedSize,selectedColor);closeLayer('productModal');openCart();return;}if(e.target.closest('#buyNowBtn')){addToCart(activeProduct,selectedSize,selectedColor);closeLayer('productModal');startCheckout();}});
    document.addEventListener('click',e=>{const qty=e.target.closest('.qty-change');if(qty){const item=cart.find(i=>i.key===qty.dataset.key);if(item){item.qty+=Number(qty.dataset.delta);if(item.qty<1)cart=cart.filter(i=>i!==item);saveCart();updateCart();}return;}const remove=e.target.closest('.remove-item');if(remove){cart=cart.filter(i=>i.key!==remove.dataset.key);saveCart();updateCart();return;}if(e.target.closest('#emptyCartShop'))closeCart();});
    function startCheckout(){if(!cart.length){showToast('Your bag is empty.');return;}checkoutStep=1;checkoutRender();openLayer('checkoutModal');}
    $('cartBtn').addEventListener('click',openCart);$('closeCart').addEventListener('click',closeCart);$('drawerBackdrop').addEventListener('click',closeCart);$('continueShopping').addEventListener('click',closeCart);$('checkoutBtn').addEventListener('click',()=>{closeCart();startCheckout();});
    ['categoryFilter','colorFilter','occasionFilter','fabricFilter','sortSelect'].forEach(id=>$(id).addEventListener('change',renderProducts));
    ['minPrice','maxPrice'].forEach(id=>$(id).addEventListener('input',renderProducts));$('priceRange').addEventListener('input',()=>{$('rangeValue').textContent=Number($('priceRange').value).toLocaleString('en-IN');$('maxPrice').value=$('priceRange').value;renderProducts();});
    $('sizeFilters').addEventListener('click',e=>{const btn=e.target.closest('[data-size-filter]');if(!btn)return;const size=btn.dataset.sizeFilter;selectedReviewSize=selectedReviewSize===size?null:size;document.querySelectorAll('[data-size-filter]').forEach(b=>b.classList.toggle('active',b.dataset.sizeFilter===selectedReviewSize));renderProducts();});
    $('clearFilters').addEventListener('click',clearFilters);$('emptyClear').addEventListener('click',clearFilters);$('gridView').addEventListener('click',()=>{document.body.classList.remove('list-view');renderProducts();});$('listView').addEventListener('click',()=>{document.body.classList.add('list-view');renderProducts();});
    document.querySelectorAll('[data-collection]').forEach(link=>link.addEventListener('click',()=>{ $('categoryFilter').value=link.dataset.collection;renderProducts();}));
    $('searchInput').addEventListener('input',e=>{ $('mobileSearchInput').value=e.target.value;openSearchResults(e.target.value,$('searchSuggestions')); });$('mobileSearchInput').addEventListener('input',e=>{ $('searchInput').value=e.target.value;openSearchResults(e.target.value,$('mobileSearchSuggestions')); });
    document.addEventListener('click',e=>{if(!e.target.closest('#searchInput')&&!e.target.closest('#searchSuggestions'))$('searchSuggestions').classList.add('hidden');if(!e.target.closest('#mobileSearchInput')&&!e.target.closest('#mobileSearchSuggestions'))$('mobileSearchSuggestions').classList.add('hidden');});
    $('mobileSearchBtn').addEventListener('click',()=>{$('mobileSearch').classList.toggle('hidden');if(!$('mobileSearch').classList.contains('hidden'))$('mobileSearchInput').focus();});$('mobileMenuBtn').addEventListener('click',()=>{$('filterPanel').classList.toggle('hidden');$('filterPanel').classList.toggle('block');$('filterPanel').scrollIntoView({behavior:'smooth',block:'start'});});$('mobileFilterDone').addEventListener('click',()=>{$('filterPanel').classList.add('hidden');$('filterPanel').classList.remove('block');});
    document.querySelector('.arrival-prev').addEventListener('click',()=>$('arrivalRow').scrollBy({left:-320,behavior:'smooth'}));document.querySelector('.arrival-next').addEventListener('click',()=>$('arrivalRow').scrollBy({left:320,behavior:'smooth'}));
    $('themeBtn').addEventListener('click',()=>{document.body.classList.toggle('dark-mode');try{localStorage.setItem('aaranya-theme',document.body.classList.contains('dark-mode')?'dark':'light');}catch{}});
    $('lightboxPrev').addEventListener('click',()=>moveLightbox(-1));$('lightboxNext').addEventListener('click',()=>moveLightbox(1));
    document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelectorAll('.modal-shell.open').forEach(m=>closeLayer(m.id));closeCart();}if($('lightbox').classList.contains('open')&&e.key==='ArrowRight')moveLightbox(1);if($('lightbox').classList.contains('open')&&e.key==='ArrowLeft')moveLightbox(-1);});
    try{if(localStorage.getItem('aaranya-theme')==='dark')document.body.classList.add('dark-mode');}catch{}
    renderArrivals();renderProducts();updateCart();
  </script>
</body>
</html>
