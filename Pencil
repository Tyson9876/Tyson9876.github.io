<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f8f6f1" />
  <meta name="description" content="Discover Aaranya: thoughtfully designed lingerie, intimates and swimwear for Indian women. Soft fabrics, considered fits and everyday confidence." />
  <title>Aaranya — Indian lingerie, intimates & swimwear</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root { --ivory:#f8f6f1; --paper:#fffefa; --ink:#24231f; --muted:#77736a; --gold:#a7834f; --line:#e8e3d9; --terracotta:#a95f48; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; background:var(--ivory); color:var(--ink); font-family:'DM Sans',sans-serif; }
    body.locked { overflow:hidden; }
    h1,h2,h3,h4,.serif { font-family:'Playfair Display',serif; }
    button,input,select,textarea { font:inherit; }
    button { cursor:pointer; }
    .announcement { background:#292823; color:#f8f6f1; }
    .site-header { background:rgba(248,246,241,.94); backdrop-filter:blur(12px); border-bottom:1px solid var(--line); }
    .brand { font-family:'Playfair Display',serif; letter-spacing:.22em; }
    .eyebrow { letter-spacing:.2em; text-transform:uppercase; font-size:.66rem; font-weight:700; }
    .gold { color:var(--gold); }
    .hero { min-height:610px; height:min(78vh,820px); background:#38352e; }
    .hero-image { object-fit:cover; object-position:center 38%; filter:brightness(.73); }
    .hero-content { animation:rise .8s both; }
    .hero-btn,.solid-btn { transition:all .25s ease; }
    .hero-btn:hover,.solid-btn:hover { transform:translateY(-2px); background:#8b6a3e; }
    .collection-card img,.product-image { transition:transform .65s cubic-bezier(.2,.7,.2,1); }
    .collection-card:hover img,.product-card:hover .product-image { transform:scale(1.045); }
    .collection-card { position:relative; overflow:hidden; background:#e5ded2; }
    .collection-card:after { content:''; position:absolute; inset:30% 0 0; background:linear-gradient(transparent,rgba(20,18,15,.62)); pointer-events:none; }
    .collection-copy { z-index:1; }
    .product-card { transition:transform .25s ease; }
    .product-card:hover { transform:translateY(-4px); }
    .product-image-wrap { position:relative; overflow:hidden; background:#ebe7df; }
    .badge { background:var(--paper); }
    .scroll-row { scrollbar-width:none; scroll-snap-type:x mandatory; }
    .scroll-row::-webkit-scrollbar { display:none; }
    .scroll-row > * { scroll-snap-align:start; }
    .pill { border:1px solid var(--line); transition:all .2s; }
    .pill.active,.pill:hover { border-color:var(--ink); background:var(--ink); color:white; }
    .filter-panel,.surface { background:var(--paper); border:1px solid var(--line); }
    .drawer-backdrop,.modal-backdrop { position:fixed; inset:0; background:rgba(20,19,17,.48); z-index:80; opacity:0; visibility:hidden; transition:opacity .25s,visibility .25s; }
    .drawer-backdrop.open,.modal-backdrop.open { opacity:1; visibility:visible; }
    .cart-drawer { position:fixed; z-index:90; top:0; right:0; bottom:0; width:min(460px,100%); background:var(--paper); transform:translateX(102%); transition:transform .35s cubic-bezier(.2,.8,.2,1); display:flex; flex-direction:column; }
    .cart-drawer.open { transform:translateX(0); }
    .modal-shell { position:fixed; z-index:95; inset:0; display:flex; align-items:center; justify-content:center; padding:20px; opacity:0; visibility:hidden; transition:opacity .25s,visibility .25s; }
    .modal-shell.open { opacity:1; visibility:visible; }
    .modal-panel { transform:translateY(14px); transition:transform .25s; }
    .modal-shell.open .modal-panel { transform:translateY(0); }
    .swatch { width:26px; height:26px; border-radius:999px; border:2px solid white; box-shadow:0 0 0 1px #d6d0c5; }
    .swatch.selected { box-shadow:0 0 0 2px var(--ink); }
    .size-option.selected { background:var(--ink); color:white; border-color:var(--ink); }
    .thumb.selected { outline:2px solid var(--gold); outline-offset:2px; }
    .toast { position:fixed; z-index:150; bottom:24px; left:50%; transform:translate(-50%,18px); opacity:0; pointer-events:none; transition:.25s; }
    .toast.show { opacity:1; transform:translate(-50%,0); }
    .dark-mode { --ivory:#201f1b; --paper:#292823; --ink:#f3f0e8; --muted:#b7b1a5; --line:#454239; }
    .dark-mode .site-header { background:rgba(32,31,27,.94); }
    .dark-mode .announcement { background:#11110f; }
    .dark-mode .filter-panel,.dark-mode .surface,.dark-mode .cart-drawer { background:var(--paper); }
    .dark-mode input,.dark-mode select,.dark-mode textarea { color:var(--ink); background:#33322c; }
    .dark-mode .text-stone-500,.dark-mode .text-stone-600,.dark-mode .text-stone-700 { color:#c2bdb2!important; }
    .dark-mode .bg-white { background-color:#292823!important; }
    .dark-mode .text-stone-900 { color:#f3f0e8!important; }
    .dark-mode .border-stone-200,.dark-mode .border-stone-300 { border-color:var(--line)!important; }
    .dark-mode .bg-stone-50 { background-color:#33322c!important; }
    .list-mode { grid-template-columns:1fr!important; }
    .list-mode .product-card { display:grid; grid-template-columns:170px 1fr; gap:20px; align-items:center; }
    .list-mode .product-image-wrap { grid-row:span 3; }
    @keyframes rise { from {opacity:0;transform:translateY(16px)} to {opacity:1;transform:translateY(0)} }
    @keyframes fade { from {opacity:0} to {opacity:1} }
    @media(max-width:640px) { .hero { min-height:560px; height:72vh; } .list-mode .product-card { grid-template-columns:112px 1fr; gap:12px; } }
  </style>
</head>
<body>
