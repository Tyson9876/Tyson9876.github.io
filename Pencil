          <label class="eyebrow text-[9px] block mb-2">Color</label><select id="colorFilter" class="w-full border border-[var(--line)] bg-[var(--paper)] p-2 text-xs mb-5"><option value="all">All colors</option><option>Sand</option><option>Cocoa</option><option>Black</option><option>Rose</option><option>Ruby</option><option>Teal</option><option>Sage</option><option>Ivory</option></select>
