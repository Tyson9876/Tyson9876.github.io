      </nav>
      <div class="flex items-center gap-1 sm:gap-3">
        <div class="relative hidden sm:block"><input id="searchInput" class="w-40 lg:w-56 rounded-full border border-[var(--line)] bg-transparent py-2 pl-9 pr-4 text-xs focus:outline-none focus:border-[#a7834f]" placeholder="Search the collection" autocomplete="off" aria-label="Search products"><span class="absolute left-3 top-2 text-base text-[var(--muted)]">⌕</span><div id="searchSuggestions" class="hidden absolute top-full right-0 mt-2 w-72 surface shadow-xl rounded-sm overflow-hidden z-[70]"></div></div>
        <button id="mobileSearchBtn" class="sm:hidden p-2 text-lg" aria-label="Search">⌕</button>
        <button id="themeBtn" class="p-2 text-sm" aria-label="Toggle color theme" title="Toggle theme">◐</button>
        <button id="cartBtn" class="relative p-2" aria-label="Open shopping bag">♧<span id="cartCount" class="absolute -top-0.5 -right-0.5 min-w-4 h-4 px-1 rounded-full bg-[#a7834f] text-white text-[9px] flex items-center justify-center">0</span></button>
      </div>
    </div>
    <div id="mobileSearch" class="hidden sm:hidden px-4 pb-3 relative"><input id="mobileSearchInput" class="w-full rounded-full border border-[var(--line)] bg-transparent py-2 pl-4 pr-4 text-sm" placeholder="Search the collection"><div id="mobileSearchSuggestions" class="hidden absolute top-full left-4 right-4 surface shadow-xl z-[70]"></div></div>
  </header>

  <main id="home">
    <section class="hero relative flex items-center justify-center text-center text-white overflow-hidden">
      <img class="hero-image absolute inset-0 w-full h-full" src="https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=2200&q=85" alt="Indian fashion model in an elegant editorial look" fetchpriority="high">
      <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/20 to-black/45"></div>
      <div class="hero-content relative max-w-3xl px-5 py-16"><p class="eyebrow text-[#e8d4ae] mb-5">A softer kind of confidence</p><h1 class="text-4xl sm:text-6xl md:text-7xl leading-[1.08] mb-6">Feel like yourself.<br><i class="font-normal">In every layer.</i></h1><p class="max-w-xl mx-auto text-sm sm:text-base text-white/85 leading-7 mb-8">Thoughtfully designed lingerie, intimates and swimwear for Indian women — made for comfort, confidence and the way you really live.</p><a href="#shop" class="hero-btn inline-block border border-white/80 px-8 py-3 text-[11px] tracking-[.2em] uppercase hover:bg-white hover:text-stone-900">Discover the collection</a></div>
      <div class="absolute bottom-7 left-1/2 -translate-x-1/2 text-[9px] tracking-[.24em] uppercase text-white/70">Comfort, confidence · always you</div>
    </section>

    <section id="collections" class="max-w-[1440px] mx-auto px-4 sm:px-8 py-16 sm:py-24">
      <div class="flex items-end justify-between mb-8 sm:mb-10"><div><p class="eyebrow gold mb-3">Find your feel</p><h2 class="text-3xl sm:text-4xl">Made for every layer</h2></div><a href="#shop" class="hidden sm:block text-xs border-b border-[#a7834f] pb-1">EXPLORE ALL <span class="ml-2">→</span></a></div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
        <a href="#shop" data-collection="bras" class="collection-card aspect-[.72] sm:aspect-[.78]"><img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=750&q=80" alt="Indian woman in a refined fashion campaign"><div class="collection-copy absolute bottom-4 sm:bottom-6 left-4 sm:left-6 text-white"><span class="eyebrow text-[8px] sm:text-[9px]">Soft support, all day</span><h3 class="text-xl sm:text-2xl mt-1">Bras</h3></div></a>
        <a href="#shop" data-collection="panties" class="collection-card aspect-[.72] sm:aspect-[.78]"><img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=750&q=80" alt="Indian woman in a soft, natural portrait"><div class="collection-copy absolute bottom-4 sm:bottom-6 left-4 sm:left-6 text-white"><span class="eyebrow text-[8px] sm:text-[9px]">Everyday, elevated</span><h3 class="text-xl sm:text-2xl mt-1">Briefs</h3></div></a>
        <a href="#shop" data-collection="thongs" class="collection-card aspect-[.72] sm:aspect-[.78]"><img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=750&q=80" alt="Indian woman wearing contemporary fashion"><div class="collection-copy absolute bottom-4 sm:bottom-6 left-4 sm:left-6 text-white"><span class="eyebrow text-[8px] sm:text-[9px]">Barely there, beautifully made</span><h3 class="text-xl sm:text-2xl mt-1">Thongs</h3></div></a>
        <a href="#shop" data-collection="swimwear" class="collection-card aspect-[.72] sm:aspect-[.78]"><img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=750&q=80" alt="Indian fashion model in a relaxed editorial look"><div class="collection-copy absolute bottom-4 sm:bottom-6 left-4 sm:left-6 text-white"><span class="eyebrow text-[8px] sm:text-[9px]">Made for the water</span><h3 class="text-xl sm:text-2xl mt-1">Swimwear</h3></div></a>
      </div>
    </section>

    <section class="bg-[#efebe3] dark:bg-[#292823] py-14 sm:py-20 overflow-hidden">
      <div class="max-w-[1440px] mx-auto px-4 sm:px-8"><div class="flex items-end justify-between mb-8"><div><p class="eyebrow gold mb-3">Just arrived</p><h2 class="text-3xl sm:text-4xl">New arrivals</h2></div><div class="flex gap-2"><button class="arrival-prev border border-[var(--line)] w-9 h-9 rounded-full hover:bg-white" aria-label="Scroll new arrivals left">←</button><button class="arrival-next border border-[var(--line)] w-9 h-9 rounded-full hover:bg-white" aria-label="Scroll new arrivals right">→</button></div></div><div id="arrivalRow" class="scroll-row flex gap-4 sm:gap-6 overflow-x-auto pb-3"></div></div>
    </section>

    <section id="shop" class="max-w-[1440px] mx-auto px-4 sm:px-8 py-16 sm:py-24">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-5 mb-8"><div><p class="eyebrow gold mb-3">The Aaranya edit</p><h2 class="text-3xl sm:text-4xl">Shop all pieces</h2><p id="resultCount" class="text-xs text-[var(--muted)] mt-3"></p></div><div class="flex flex-wrap gap-2 items-center"><select id="sortSelect" class="border border-[var(--line)] bg-[var(--paper)] px-3 py-2 text-xs rounded-sm"><option value="newest">Newest first</option><option value="price-asc">Price: low to high</option><option value="price-desc">Price: high to low</option><option value="popular">Most loved</option></select><div class="flex border border-[var(--line)]"><button id="gridView" class="px-3 py-2 text-sm bg-[var(--paper)]" aria-label="Grid view">▦</button><button id="listView" class="px-3 py-2 text-sm" aria-label="List view">☷</button></div></div></div>
      <div class="grid lg:grid-cols-[220px_1fr] gap-8">
        <aside id="filterPanel" class="filter-panel p-5 h-fit lg:sticky lg:top-28 hidden lg:block">
          <div class="flex items-center justify-between mb-5"><h3 class="serif text-xl">Refine</h3><button id="clearFilters" class="text-[10px] underline text-[var(--muted)]">Clear all</button></div>
          <label class="eyebrow text-[9px] block mb-2">Category</label><select id="categoryFilter" class="w-full border border-[var(--line)] bg-[var(--paper)] p-2 text-xs mb-5"><option value="all">All categories</option><option value="bras">Bras</option><option value="panties">Briefs</option><option value="thongs">Thongs</option><option value="swimwear">Swimwear</option></select>
          <label class="eyebrow text-[9px] block mb-2">Price range · ₹</label><div class="grid grid-cols-2 gap-2 mb-2"><input id="minPrice" type="number" min="0" placeholder="Min" class="w-full border border-[var(--line)] bg-[var(--paper)] p-2 text-xs"><input id="maxPrice" type="number" min="0" placeholder="Max" class="w-full border border-[var(--line)] bg-[var(--paper)] p-2 text-xs"></div><input id="priceRange" type="range" min="5000" max="50000" step="1000" value="50000" class="w-full accent-[#a7834f] mb-5"><p class="text-[10px] text-[var(--muted)] -mt-4 mb-5">Up to ₹<span id="rangeValue">50,000</span></p>
